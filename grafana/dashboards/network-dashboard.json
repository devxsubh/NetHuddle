{
  "dashboard": {
    "title": "Network Communication System Dashboard",
    "tags": ["network", "websocket", "webrtc", "quic"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "HTTP Requests Rate",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(http_requests_total[5m])",
            "legendFormat": "{{method}} {{route}}"
          }
        ],
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 }
      },
      {
        "id": 2,
        "title": "HTTP Request Duration",
        "type": "graph",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket[5m]))",
            "legendFormat": "p95"
          },
          {
            "expr": "histogram_quantile(0.99, rate(http_request_duration_seconds_bucket[5m]))",
            "legendFormat": "p99"
          }
        ],
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 }
      },
      {
        "id": 3,
        "title": "WebSocket Connections",
        "type": "graph",
        "targets": [
          {
            "expr": "websocket_connections_total",
            "legendFormat": "Connections"
          }
        ],
        "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 }
      },
      {
        "id": 4,
        "title": "WebSocket Messages",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(websocket_messages_total[5m])",
            "legendFormat": "{{event_type}}"
          }
        ],
        "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 }
      },
      {
        "id": 5,
        "title": "Network Users",
        "type": "graph",
        "targets": [
          {
            "expr": "network_users_total",
            "legendFormat": "{{network_subnet}}"
          }
        ],
        "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 }
      },
      {
        "id": 6,
        "title": "Network RTT",
        "type": "graph",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(network_rtt_seconds_bucket[5m]))",
            "legendFormat": "p95 RTT"
          }
        ],
        "gridPos": { "h": 8, "w": 8, "x": 0, "y": 16 }
      },
      {
        "id": 7,
        "title": "File Transfers",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(file_transfers_total[5m])",
            "legendFormat": "{{status}}"
          }
        ],
        "gridPos": { "h": 8, "w": 8, "x": 8, "y": 16 }
      },
      {
        "id": 8,
        "title": "File Transfer Size",
        "type": "graph",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(file_transfer_size_bytes_bucket[5m]))",
            "legendFormat": "p95 Size"
          }
        ],
        "gridPos": { "h": 8, "w": 8, "x": 16, "y": 16 }
      },
      {
        "id": 9,
        "title": "WebRTC Connections",
        "type": "graph",
        "targets": [
          {
            "expr": "webrtc_connections_total",
            "legendFormat": "Connections"
          }
        ],
        "gridPos": { "h": 8, "w": 8, "x": 0, "y": 24 }
      },
      {
        "id": 10,
        "title": "QUIC Connections",
        "type": "graph",
        "targets": [
          {
            "expr": "quic_connections_total",
            "legendFormat": "Connections"
          }
        ],
        "gridPos": { "h": 8, "w": 8, "x": 8, "y": 24 }
      },
      {
        "id": 11,
        "title": "QUIC Stream Bytes",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(quic_stream_bytes_total[5m])",
            "legendFormat": "{{direction}}"
          }
        ],
        "gridPos": { "h": 8, "w": 8, "x": 16, "y": 24 }
      },
      {
        "id": 12,
        "title": "Database Query Duration",
        "type": "graph",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(database_query_duration_seconds_bucket[5m]))",
            "legendFormat": "{{operation}} {{collection}}"
          }
        ],
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 }
      },
      {
        "id": 13,
        "title": "Database Queries Rate",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(database_queries_total[5m])",
            "legendFormat": "{{operation}} {{collection}} {{status}}"
          }
        ],
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 }
      }
    ],
    "refresh": "5s",
    "schemaVersion": 27,
    "version": 1
  }
}

